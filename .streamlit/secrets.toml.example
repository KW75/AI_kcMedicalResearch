# Copy this file to .streamlit/secrets.toml and add your API keys

# Qwen (recommended) - Get from: https://dashscope.aliyuncs.com
QWEN_API_KEY = "sk-your-qwen-key-here"

# OpenAI - Get from: https://platform.openai.com
OPENAI_API_KEY = "sk-your-openai-key-here"

# Anthropic - Get from: https://console.anthropic.com
ANTHROPIC_API_KEY = "sk-ant-your-anthropic-key-here"

# DeepSeek - Get from: https://platform.deepseek.com
DEEPSEEK_API_KEY = "sk-your-deepseek-key-here"

# Groq (free) - Get from: https://console.groq.com
GROQ_API_KEY = "gsk_your-groq-key-here"
