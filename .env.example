# =============================================================================
#  AI kcMedicalResearch - environment configuration
#  v2.4.6
#
#  Copy this file to .env in the project root and fill in the keys you need:
#      Windows :  copy .env.example .env
#      macOS   :  cp .env.example .env
#
#  .env is gitignored. Never commit real keys, and never screenshot a terminal
#  that has run a launcher.
# =============================================================================

# --- Provider selection ------------------------------------------------------
# Any of: deepseek, qwen, openai, anthropic, groq, ollama
DEFAULT_PROVIDER=deepseek

# Tried in order on transient errors only (timeout, 429, 502, 503).
# Auth errors (401, 403) raise immediately without falling back.
FALLBACK_PROVIDERS=deepseek,qwen,groq


# --- DeepSeek (default) ------------------------------------------------------
# https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash


# --- Qwen / DashScope (recommended for the SR pipeline) ----------------------
# https://dashscope.aliyuncs.com
# Replace DASHSCOPE_BASE_URL only if your account uses a dedicated endpoint.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_ANTHROPIC_URL=

# Text model for coding/writing/appraisal/search modes.
QWEN_MODEL=qwen-plus-latest

# IMPORTANT: the SR pipeline reads data from PDF page images and needs a vision
# model. QWEN_MODEL above is text-only and will return empty extractions.
# Leave this set unless you have a reason to change it.
QWEN_VISION_MODEL=qwen-vl-max


# --- Groq --------------------------------------------------------------------
# Free tier available: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile


# --- OpenAI ------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini


# --- Anthropic ---------------------------------------------------------------
# Geo-restricted in some regions; use a VPN or another provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6


# --- Ollama (local, no API key) ----------------------------------------------
# Free but slow with large models. Not usable for SR: no vision support.
#
# Running in Docker? "localhost" means the container, not your machine.
# The Docker launchers override this with host.docker.internal for you.
OLLAMA_HOST=http://localhost:11434
OLLAMA_CONTEXT=32768
OLLAMA_NUM_PREDICT=8192
OLLAMA_TEMPERATURE=0.3


# --- RAG / embeddings --------------------------------------------------------
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
UPLOAD_DIR=uploads


# --- Systematic review ------------------------------------------------------
# Reviewer-verified per-study corrections, keyed by PDF filename.
# See Readme/REVIEWER_GUIDE.md before relying on any SR output.
SR_STUDY_OVERRIDES=input/sr/study_overrides.yaml


# --- CLI ---------------------------------------------------------------------
CLI_THEME=dark
