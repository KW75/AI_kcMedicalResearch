# =============================================================================
#  AI kcMedicalResearch - environment configuration
#
#  Copy this file to .env in the project root and fill in the keys you need:
#      Windows :  copy .env.example .env
#      macOS   :  cp .env.example .env
#
#  .env is gitignored. Never commit real keys, and never screenshot a terminal
#  that has run a launcher.
# =============================================================================

# --- Provider selection ------------------------------------------------------
# Any of: deepseek, qwen, openai, anthropic, groq, ollama
DEFAULT_PROVIDER=ollama

# Tried in order on transient errors only (timeout, 429, 502, 503).
# Auth errors (401, 403) raise immediately without falling back.
FALLBACK_PROVIDERS=deepseek,qwen,groq


# --- DeepSeek ------------------------------------------------------
# https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash


# --- Qwen / DashScope (recommended for the SR pipeline) ----------------------
# https://dashscope.aliyuncs.com
# Replace DASHSCOPE_BASE_URL only if your account uses a dedicated endpoint.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1



# Text model for coding/writing/appraisal/search modes.
QWEN_MODEL=qwen-plus-latest

# IMPORTANT: the SR pipeline reads data from PDF page images and needs a vision
# model. QWEN_MODEL above is text-only and will return empty extractions.
# Leave this set unless you have a reason to change it.
QWEN_VISION_MODEL=qwen-vl-max


# --- Groq --------------------------------------------------------------------
# Free tier available: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile


# --- OpenAI ------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini


# --- Anthropic ---------------------------------------------------------------
# Geo-restricted in some regions; use a VPN or another provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5


# --- Ollama (local, no API key) ----------------------------------------------
# Local and private: nothing leaves your machine. Use this for confidential or
# patient-identifiable data (writing, appraisal). Not usable for SR yet: the
# app does not send images to Ollama.
#
# Recommended model: gemma4:e4b (about 6.6 GB; needs Ollama 0.30.9 or newer).
# It reads images, which the planned OCR mode needs. On an older or slower
# machine, pull a smaller chat model instead and put its name below.
# First pull the model(s) in a terminal:
#     ollama pull gemma4:e4b
#     ollama pull nomic-embed-text

# OLLAMA_MODEL is your default local model. Leave it as-is unless you pulled
# a different chat model; then put its exact name here. If the line is
# commented out, the app uses gemma4:e4b. The app never switches model on
# its own: if this model is not pulled, the job stops and tells you to run
# "ollama pull <model>". The launcher also lets you pick another pulled
# model for a single job.
OLLAMA_MODEL=gemma4:e4b

#
# Note on code generation (demo): the coding mode self-checks over several
# passes, so it is slow on a local model and may finish with a MAXITER_WARNING
# file. That output is still usable - it just did not pass every automatic check.
OLLAMA_HOST=http://localhost:11434
OLLAMA_CONTEXT=32768
OLLAMA_NUM_PREDICT=8192
OLLAMA_TEMPERATURE=0.3


# --- RAG / embeddings --------------------------------------------------------
# Keep EMBEDDING_PROVIDER=ollama for confidential work: it keeps document
# indexing local. Setting it to openai sends document chunks to OpenAI.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
UPLOAD_DIR=uploads


# --- Systematic review ------------------------------------------------------
# Reviewer-verified per-study corrections, keyed by PDF filename.
# See Readme/REVIEWER_GUIDE.md before relying on any SR output.
SR_STUDY_OVERRIDES=input/sr/study_overrides.yaml


# --- CLI ---------------------------------------------------------------------
CLI_THEME=dark
